# =============================================================
# AI Car Insurance System — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================

# ----- PostgreSQL -----
DATABASE_URL=postgresql+asyncpg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/ai_car_insurance

# ----- JWT Authentication -----
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secret_key_at_least_32_chars
ALGORITHM=HS256
# Token expiry in minutes (default 60 minutes = 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----- File Uploads -----
# Directory where claim images are stored (relative to Backend/)
UPLOAD_DIR=uploads/claim_images

# ----- AI Model -----
# Place your trained best_model.pth file at this path.
# The file is generated by the ViT-B/16 notebook in AI-ML/.
# After training on Colab, download best_model.pth and place it at:
#   Backend/ai_model/best_model.pth
# Then set MODEL_PATH=ai_model/best_model.pth
MODEL_PATH=ai_model/best_model.pth

# ----- CORS -----
# Frontend development server URL
FRONTEND_URL=http://localhost:5173

# ----- Email (Gmail SMTP) -----
# Steps to set this up:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Create an App Password for "Mail" (requires 2FA enabled on Gmail)
# 3. Paste the 16-character App Password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASSWORD=your_16_char_app_password
EMAIL_FROM=InsureAI <your_gmail@gmail.com>
